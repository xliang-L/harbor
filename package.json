{
  "name": "harbor-marketing-agent",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/server/*.test.ts",
    "test:e2e": "playwright test",
    "test:public": "MODEL_ENABLED=false node --import tsx scripts/verify/sources.ts",
    "test:e2e:remotion": "TEST_RENDERER=remotion playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "cheerio": "^1.1.2",
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "hyperframes": "0.8.150",
    "ipaddr.js": "^2.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "4.0.535",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/darwin-arm64": "^4.1.5",
    "@ffprobe-installer/darwin-arm64": "^5.0.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "A local-first marketing workspace: evidence, content, review, delivery and results.",
  "repository": {
    "type": "git",
    "url": "https://github.com/xliang-L/harbor.git"
  },
  "homepage": "https://github.com/xliang-L/harbor",
  "bugs": {
    "url": "https://github.com/xliang-L/harbor/issues"
  },
  "author": "xliang-L",
  "keywords": [
    "marketing",
    "local-first",
    "ai",
    "content-workflow",
    "human-in-the-loop",
    "sqlite",
    "typescript"
  ]
}
