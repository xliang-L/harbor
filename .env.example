# Default is offline deterministic templates, no model calls.
MODEL_ENABLED=false
# Use an authorized OpenAI-compatible /v1 endpoint.
# Evidence and brand content are sent to this service when model mode is enabled.
MODEL_BASE_URL=
# Exact model ID offered by your configured provider.
MODEL_NAME=
MODEL_API_KEY=
# Optional overrides. macOS arm64 npm binaries are bundled as optional deps.
# HYPERFRAMES_BROWSER_PATH=/absolute/path/to/chrome
# HYPERFRAMES_FFMPEG_PATH=/absolute/path/to/ffmpeg
# HYPERFRAMES_FFPROBE_PATH=/absolute/path/to/ffprobe
PORT=4317
DATA_DIR=data
# Optional Remotion browser override (otherwise shares HyperFrames Chrome path).
# REMOTION_BROWSER_PATH=/absolute/path/to/chrome
# Optional read-only GA4. User must authorize analytics.readonly and property access.
# No token is created/refreshed by Harbor; expired tokens fail visibly.
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=

# Optional Postiz read-only adapter. API keys may have write privileges upstream;
# Harbor uses only GET integrations/posts, and never publishes or creates receipts automatically.
# Default brand: explicitly configure the public API root and ONE integration ID.
# Hosted root: https://api.postiz.com/public/v1
# Local self-hosted example: http://127.0.0.1:4007/api/public/v1
POSTIZ_BASE_URL=
POSTIZ_API_KEY=
POSTIZ_INTEGRATION_ID=
# Other brands use their own prefix (brand-demo -> POSTIZ_BRAND_DEMO_*).
# No fallback to default-brand credentials or accounts.
# POSTIZ_BRAND_DEMO_BASE_URL=
# POSTIZ_BRAND_DEMO_API_KEY=
# POSTIZ_BRAND_DEMO_INTEGRATION_ID=
